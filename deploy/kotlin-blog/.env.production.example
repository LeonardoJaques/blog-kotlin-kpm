# Generate a unique value on the host, e.g. `openssl rand -hex 32`.
DATABASE_PASSWORD=replace-with-a-long-random-secret

# Reader verification and password-reset mail (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-account
SMTP_PASSWORD=your-gmail-app-password
SMTP_STARTTLS=true
SMTP_FROM=Convergencia Blog <no-reply@example.com>
